{
  "name": "potalk-cli",
  "version": "1.0.0",
  "description": "ぽっと通話のCLI版クライアント",
  "main": "ptk.mjs",
  "scripts": {
    "start": "node ptk.mjs",
    "list": "node ptk.mjs list",
    "test": "node --test test/*.test.mjs && npm run test:ollama-dry-run",
    "test:ollama-dry-run": "python3 -m unittest discover -s test -p 'test_ollama_dry_run.py'",
    "test:tts-router": "python3 -m unittest discover -s test -p 'test_*.py'"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@roamhq/wrtc": "0.10.0",
    "blessed": "0.1.81",
    "nostr-tools": "2.20.0",
    "trystero": "0.25.4",
    "ws": "^8.22.0"
  },
  "bin": {
    "ptk": "ptk.mjs"
  },
  "engines": {
    "node": ">=20.6"
  }
}
